[Unit]
Description=OpenCode Voice STT/PTT
After=graphical-session.target

[Service]
Type=simple
# Run as a login session so the graphical session's environment
# (DISPLAY / XDG_SESSION_TYPE / WAYLAND_DISPLAY) is inherited —
# required for type_into_opencode() to inject text via xdotool/wtype.
PAMName=login
WorkingDirectory=%h/.local/share/opencode-voice
# Backend: cuda (default) or cpu
# Environment=OPENCODE_STT_DEVICE=cpu
ExecStart=%h/.local/share/opencode-voice/.venv/bin/python %h/.local/share/opencode-voice/voice.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
